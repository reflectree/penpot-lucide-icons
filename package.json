    "@types/node": "^24.13.2",
    "rolldown": "^1.2.1",
    "svelte": "^5.56.4",
    "svelte-check": "^4.7.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-generate-file": "^0.3.1"
  },
  "dependencies": {
    "@lucide/svelte": "^1.28.0",
    "@penpot/plugin-styles": "^1.4.2",
    "@tailwindcss/vite": "^4.3.3",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "es-toolkit": "^1.50.0",
    "fuse.js": "^7.5.0",
    "glob": "^13.0.6",
    "runed": "^0.37.1",
    "simple-git": "^3.36.0",
