{
  "name": "penpot-lucide-icons",
  "description": "Lucide plugin for Penpot",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev-build": "NODE_ENV=development vite build --mode development && vite preview",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "generate-icons": "jiti ./scripts/generate-icons.ts"
  },
  "devDependencies": {
    "@penpot/plugin-types": "^1.4.2",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
